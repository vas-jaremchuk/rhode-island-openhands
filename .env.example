# Copy to .env for local overrides. Nothing here is required for local development:
# app.js falls back to sqlite://data/site.db.

# Database (SQLite file, no server). Postgres or MongoDB work with the same code:
#   postgres://user:password@localhost:5432/organo_ri
#   mongodb://localhost:27017/organo-ri
APOS_DB_URI=sqlite://data/site.db

# Required in production.
SESSION_SECRET=change-me

# Port of the web server (default 3000).
# PORT=3000

# Set to 1 to rebuild the admin UI on every restart (only for Apostrophe admin UI work).
# APOS_DEV=1
